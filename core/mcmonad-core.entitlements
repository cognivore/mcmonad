<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone access for the Spotlight launcher's voice input. Paired
         with NSMicrophoneUsageDescription in the embedded Info.plist. Only
         enforced under the hardened runtime / App Sandbox, but declared here
         so the signature states intent and is ready if the runtime is
         hardened later. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
