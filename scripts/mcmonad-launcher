#!/bin/bash
# mcmonad-launcher — manages both mcmonad-core and mcmonad processes.
# Lives at MCMonad.app/Contents/MacOS/mcmonad-launcher.
#
# Modes:
#   --daemon     Run both processes (called by launchd)
#   --install    Install launchd agent and start
#   --uninstall  Remove launchd agent
#   (default)    First-launch: install agent if missing, then start daemon
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
LOG_DIR="$HOME/Library/Logs"
CORE_LOG="$LOG_DIR/mcmonad-core.log"
HASKELL_LOG="$LOG_DIR/mcmonad.log"
LAUNCHER_LOG="$LOG_DIR/mcmonad-launcher.log"
AGENT_LABEL="com.mcmonad.agent"
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"

# Time-based log rotation. The core's FocusLog/FrameLog are deliberately
# chatty, but disk is cheap and a couple of days of history is worth far
# more for debugging than a tight size cap. So we rotate by DAY and keep
# the last MCMONAD_LOG_RETAIN_DAYS generations (default 2): the first
# rotation of a new calendar day shifts the live log to .1, .1 to .2, and
# drops anything past the retain count. A marker file records the day we
# last rotated so the many daemon restarts within a day don't churn.
# In-place truncation (': > file') is required because the core/haskell
# children hold the file open in append mode (O_APPEND) — a rename would
# leave them writing to the rotated-away inode, whereas truncation resets
# the length and append writes resume from zero.
LOG_RETAIN_DAYS="${MCMONAD_LOG_RETAIN_DAYS:-2}"
LOGROTATE_MARKER="$LOG_DIR/.mcmonad-logrotate-day"

log() { echo "[mcmonad-launcher] $(date '+%H:%M:%S') $*" >&2; }

# Shift one log's daily generations down and truncate the live file.
rotate_one() {
    local f="$1"
    [ -f "$f" ] || return 0
    rm -f "$f.$LOG_RETAIN_DAYS" 2>/dev/null || true
    local i="$LOG_RETAIN_DAYS"
    while [ "$i" -gt 1 ]; do
        local prev=$((i - 1))
        [ -f "$f.$prev" ] && mv -f "$f.$prev" "$f.$i" 2>/dev/null || true
        i="$prev"
    done
    cp -f "$f" "$f.1" 2>/dev/null || true
    : > "$f"
}

# Rotate all logs once per calendar day, keyed off a marker file so the
# many restarts within one day are no-ops.
maybe_rotate_logs() {
    local today last=""
    today="$(date +%Y%m%d)"
    [ -f "$LOGROTATE_MARKER" ] && last="$(cat "$LOGROTATE_MARKER" 2>/dev/null || echo)"
    [ "$today" = "$last" ] && return 0
    rotate_one "$CORE_LOG"
    rotate_one "$HASKELL_LOG"
    rotate_one "$LAUNCHER_LOG"
    echo "$today" > "$LOGROTATE_MARKER"
    log "rotated logs for $today (retaining ${LOG_RETAIN_DAYS} day(s))"
}

# Support both .app bundle (binaries alongside launcher) and home-manager
# (paths passed via MCMONAD_CORE_BIN / MCMONAD_HASKELL_BIN env vars).
CORE_BIN="${MCMONAD_CORE_BIN:-$APP_DIR/MacOS/mcmonad-core}"
DEFAULT_HASKELL_BIN="${MCMONAD_HASKELL_BIN:-$APP_DIR/MacOS/mcmonad}"

# TCC-disclaim spawn shim. When present, mcmonad-core is launched through it
# so the daemon is its OWN TCC-responsible process — otherwise macOS
# attributes the Microphone/Speech permission prompt to this launcher (the
# app bundle's main executable) rather than to com.mcmonad.core, and the
# grant never sticks to the binary that carries the usage strings. Compiled
# and signed during home-manager activation; absent for a raw .app, in which
# case we spawn the core directly (mic prompt then attributes to the bundle).
TCC_SPAWN="$APP_DIR/MacOS/mcmonad-tcc-spawn"

# Spawn mcmonad-core (through the shim if available) backgrounded, with output
# to the core log. Sets CORE_PID to the supervised pid (the shim's — it lives
# exactly as long as core and forwards signals, so the death/restart and
# cleanup logic is unchanged).
start_core() {
    if [ -x "$TCC_SPAWN" ]; then
        "$TCC_SPAWN" "$CORE_BIN" >> "$CORE_LOG" 2>&1 &
    else
        "$CORE_BIN" >> "$CORE_LOG" 2>&1 &
    fi
    CORE_PID=$!
}

# MCMONAD_GHC: path to a GHC that has the mcmonad library.
# Set by home-manager module or derived from the app bundle below.
# Required for Mod-q recompilation — not defaulted.
if [ -z "${MCMONAD_GHC:-}" ]; then
    BUNDLED_GHC="$APP_DIR/MacOS/mcmonad-ghc"
    if [ -x "$BUNDLED_GHC" ]; then
        export MCMONAD_GHC="$BUNDLED_GHC"
        log "Using bundled GHC: $BUNDLED_GHC"
    fi
fi

# Prefer the user-compiled custom binary over the bundled default — but
# only when its IPC protocol stamp matches the bundle's. The custom
# binary is produced by Mod-q (recompile) and lives at
# ~/.config/mcmonad/mcmonad-<arch>-<os> with a sidecar
# <bin>.proto holding its protocol version. A stamp file shipped in the
# bundle at Contents/Resources/protocol-version holds the bundled
# binary's version. When the two disagree (e.g. the user has a Mod-q
# binary from before an mcmonad upgrade that bumped the IPC), we fall
# back to the bundled binary instead of crash-looping on every event.
UNAME_ARCH="$(uname -m)"
case "$UNAME_ARCH" in
    arm64) GHC_ARCH="aarch64" ;;
    *)     GHC_ARCH="$UNAME_ARCH" ;;
esac
CUSTOM_BIN="$HOME/.config/mcmonad/mcmonad-${GHC_ARCH}-darwin"
CUSTOM_STAMP="$CUSTOM_BIN.proto"
BUNDLED_STAMP="$APP_DIR/Resources/protocol-version"

HASKELL_BIN="$DEFAULT_HASKELL_BIN"
if [ -x "$CUSTOM_BIN" ]; then
    if [ -f "$CUSTOM_STAMP" ] && [ -f "$BUNDLED_STAMP" ]; then
        custom_v=$(tr -d '[:space:]' < "$CUSTOM_STAMP")
        bundled_v=$(tr -d '[:space:]' < "$BUNDLED_STAMP")
        if [ -n "$custom_v" ] && [ "$custom_v" = "$bundled_v" ]; then
            HASKELL_BIN="$CUSTOM_BIN"
            log "Using custom binary (proto v$custom_v): $CUSTOM_BIN"
        else
            log "Custom binary proto v${custom_v:-?} != bundled v${bundled_v:-?}; using bundled"
        fi
    else
        log "Custom binary lacks protocol stamp; using bundled"
    fi
fi

install_agent() {
    mkdir -p "$HOME/Library/LaunchAgents" "$LOG_DIR"

    # Generate plist pointing to this .app's launcher
    cat > "$AGENT_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$AGENT_LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$APP_DIR/MacOS/mcmonad-launcher</string>
        <string>--daemon</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$LOG_DIR/mcmonad-launcher.log</string>
    <key>StandardErrorPath</key>
    <string>$LOG_DIR/mcmonad-launcher.log</string>
</dict>
</plist>
PLIST

    launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST" 2>/dev/null || true
    log "Installed and loaded launchd agent"
}

uninstall_agent() {
    launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
    rm -f "$AGENT_PLIST"
    log "Removed launchd agent"
}

run_daemon() {
    maybe_rotate_logs

    log "Starting mcmonad-core"
    start_core

    log "Starting mcmonad (haskell)"
    "$HASKELL_BIN" >> "$HASKELL_LOG" 2>&1 &
    HASKELL_PID=$!

    cleanup() {
        log "Shutting down"
        kill "$CORE_PID" "$HASKELL_PID" 2>/dev/null || true
        wait "$CORE_PID" "$HASKELL_PID" 2>/dev/null || true
        # Without this exit, the trap returns to run_daemon's while
        # loop, which sees the children dead, logs "X died, restarting"
        # and respawns them — orphaning the daemon from launchd. Exit
        # cleanly instead; launchd's KeepAlive=true brings the launcher
        # back as a fresh process.
        exit 0
    }
    trap cleanup TERM INT

    # Monitor both processes. If either dies, restart it. Check for a day
    # rollover roughly once a minute (every 30th 2s tick) so a long-lived
    # daemon rotates at the start of each new day without a restart.
    local tick=0
    while true; do
        if ! kill -0 "$CORE_PID" 2>/dev/null; then
            log "mcmonad-core died, restarting"
            start_core
        fi
        if ! kill -0 "$HASKELL_PID" 2>/dev/null; then
            log "mcmonad died, restarting"
            "$HASKELL_BIN" >> "$HASKELL_LOG" 2>&1 &
            HASKELL_PID=$!
        fi
        tick=$((tick + 1))
        if [ "$((tick % 30))" -eq 0 ]; then
            maybe_rotate_logs
        fi
        sleep 2
    done
}

case "${1:-}" in
    --daemon)
        run_daemon
        ;;
    --install)
        install_agent
        ;;
    --uninstall)
        uninstall_agent
        ;;
    *)
        # Default: first-launch behavior
        if [ ! -f "$AGENT_PLIST" ]; then
            log "First launch — installing launchd agent"
            install_agent
        else
            # Agent exists, just run as daemon (likely called manually)
            run_daemon
        fi
        ;;
esac
